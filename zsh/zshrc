# Powerlevel10k instant prompt — keep near the top.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

BREW=/opt/homebrew

# --- PATH ---
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$HOME/.local/bin:$ASDF_DATA_DIR/shims:$HOME/.antigravity/antigravity/bin:$PATH:$HOME/.lmstudio/bin"
typeset -U path   # drop duplicate PATH entries

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE

# --- Completion ---
fpath=($BREW/share/zsh/site-functions $fpath)
autoload -Uz compinit && compinit -C
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'   # case-insensitive

# --- Aliases (eza) ---
alias ls='eza --group-directories-first'
alias ll='eza -lah --git --group-directories-first'
alias tree='eza --tree'

# --- Tools ---
source <(fzf --zsh)          # Ctrl-R history, Ctrl-T files, Alt-C folders
eval "$(zoxide init zsh)"    # z <name>, zi = picker
alias lg='lazygit'
alias t='tmux new -A -s main'   # attach to (or create) session "main"

# --- Prompt ---
source $BREW/share/powerlevel10k/powerlevel10k.zsh-theme
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# --- Plugins (syntax-highlighting must be last) ---
source $BREW/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $BREW/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
